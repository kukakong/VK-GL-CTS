	cd /workspace/build-android-arm32 && $(MAKE) $(MAKESILENT) -f framework/egl/CMakeFiles/eglutil.dir/build.make framework/egl/CMakeFiles/eglutil.dir/egluUtil.cpp.s
.PHONY : egluUtil.cpp.s

